# Google OAuth client of type "Web application" (redirect URI: http://localhost:8000/auth/callback)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Agent
ANTHROPIC_API_KEY=sk-ant-...

# Optional: port 8000 is the default. If you change it, the Google redirect URI must match.
# MCP_PORT=8000
# MCP_SERVER_URL=http://localhost:8000/mcp
